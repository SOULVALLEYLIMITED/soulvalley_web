# ------------------------------------------------------------
# Soulvalley — static export hosting config (Namecheap / Apache)
# ------------------------------------------------------------

# Force HTTPS
<IfModule mod_rewrite.c>
  RewriteEngine On

  # Redirect all http:// traffic to https://
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

  # Serve clean URLs: /privacy -> /privacy.html
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_FILENAME}\.html -f
  RewriteRule ^(.+?)/?$ $1.html [L]
</IfModule>

# Custom 404 page (generated by the Next.js export)
ErrorDocument 404 /404.html

# ------------------------------------------------------------
# Compression
# ------------------------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript \
    application/javascript application/json application/x-javascript \
    image/svg+xml application/vnd.ms-fontobject application/x-font-ttf font/opentype
</IfModule>

# ------------------------------------------------------------
# Caching
# ------------------------------------------------------------
<IfModule mod_expires.c>
  ExpiresActive On

  # Hashed, immutable build assets — cache hard
  <IfModule mod_headers.c>
    <FilesMatch "\.(js|css|woff2?|ttf|otf|eot)$">
      Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
  </IfModule>

  # Images
  ExpiresByType image/jpeg               "access plus 1 year"
  ExpiresByType image/png                "access plus 1 year"
  ExpiresByType image/webp               "access plus 1 year"
  ExpiresByType image/svg+xml            "access plus 1 year"
  ExpiresByType image/x-icon             "access plus 1 year"

  # HTML — always revalidate so deploys show up immediately
  ExpiresByType text/html                "access plus 0 seconds"
</IfModule>
